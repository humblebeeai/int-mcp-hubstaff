# Hubstaff API Configuration
# HUBSTAFF_REFRESH_TOKEN is OPTIONAL. Auth is per-user: each caller sends
# their own Hubstaff PAT as the X-MCP-API-Key header. This env token is only
# a fallback for the reserved "default" key used when no header is sent.
# HUBSTAFF_REFRESH_TOKEN=your_refresh_token_here
HUBSTAFF_ORGANIZATION_ID=your_organization_id_here
HUBSTAFF_TASKS_ORGANIZATION_ID=your_tasks_organization_id_here
PORT=8000

# LOG_LEVEL=INFO

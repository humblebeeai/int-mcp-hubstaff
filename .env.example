# Hubstaff API Configuration
HUBSTAFF_ORGANIZATION_ID=your_organization_id_here
PORT=8000

# LOG_LEVEL=INFO

# --- OAuth broker (zero-paste per-user auth) --------------------------------
# Auth is OAuth-only: each user logs into Hubstaff in the browser (no PAT).
# Register ONE Hubstaff OAuth app (Account -> OAuth apps) with redirect URI
#   https://hubstaff.hbai.dev/oauth/hubstaff/callback
# and scopes: openid profile email hubstaff:read hubstaff:write tasks:read tasks:write
# Then set these (REQUIRED — the server has no other auth method).
HUBSTAFF_CLIENT_ID=your_hubstaff_oauth_client_id
HUBSTAFF_CLIENT_SECRET=your_hubstaff_oauth_client_secret

# Public, externally-visible HTTPS origin of THIS server. All OAuth metadata
# URLs, the resource identifier, and the upstream redirect_uri are built from it.
PUBLIC_BASE_URL=https://hubstaff.hbai.dev

# SQLite file for OAuth state. Must sit on the ./data directory bind-mount.
# OAUTH_DB_PATH=/app/data/oauth.db

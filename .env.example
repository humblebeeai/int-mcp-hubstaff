# Hubstaff API Configuration
HUBSTAFF_REFRESH_TOKEN=your_refresh_token_here
HUBSTAFF_ORGANIZATION_ID=your_organization_id_here
HUBSTAFF_TASKS_ORGANIZATION_ID=your_tasks_organization_id_here
PORT=8000

# LOG_LEVEL=INFO

# How auth works:
# Each caller sends their OWN Hubstaff Personal Access Token (PAT) as the
# `X-MCP-API-Key` header. Hubstaff's API then enforces project-level roles,
# so a PM can only see/manage projects where they have the manager role.
# HUBSTAFF_REFRESH_TOKEN above is only a fallback for the reserved "default"
# key used when no header is sent (e.g. local testing / the service account).